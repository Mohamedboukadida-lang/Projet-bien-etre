# Copy to .env (never commit .env).
# Hugging Face token with the "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Any chat model available on Hugging Face Inference Providers.
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
MONGO_USER=rootuser
MONGO_PASSWORD=rootpass
